[Unit]
Description=Guaca workspace daemon
Documentation=https://github.com/madebywelch/guaca/blob/main/docs/HOSTING.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/guacad
Environment=GUACA_ROOT=/var/lib/guaca
Environment=GUACA_WEB=/usr/share/guaca/web
EnvironmentFile=-/etc/guaca/guacad.env
DynamicUser=yes
StateDirectory=guaca
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
