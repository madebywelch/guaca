[
  {
    "input": {
      "connectors": [
        {
          "service": "Stripe",
          "envVar": "STRIPE_KEY"
        }
      ],
      "command": "curl -u $STRIPE_KEY: https://api.stripe.com/v1/charges",
      "summary": "exit 0, 9 bytes out"
    },
    "expected": {
      "written": "used Stripe ($STRIPE_KEY) · exit 0, 9 bytes out",
      "spent": [
        "Stripe ($STRIPE_KEY)"
      ]
    }
  },
  {
    "input": {
      "connectors": [
        {
          "service": "Stripe",
          "envVar": "STRIPE_KEY"
        }
      ],
      "command": "echo ${STRIPE_KEY}",
      "summary": "exit 0"
    },
    "expected": {
      "written": "used Stripe ($STRIPE_KEY) · exit 0",
      "spent": [
        "Stripe ($STRIPE_KEY)"
      ]
    }
  },
  {
    "input": {
      "connectors": [
        {
          "service": "Stripe",
          "envVar": "STRIPE_KEY"
        },
        {
          "service": "Mistral",
          "envVar": "MISTRAL_API_KEY"
        }
      ],
      "command": "run $STRIPE_KEY $MISTRAL_API_KEY",
      "summary": "exit 1"
    },
    "expected": {
      "written": "used Mistral ($MISTRAL_API_KEY), Stripe ($STRIPE_KEY) · exit 1",
      "spent": [
        "Mistral ($MISTRAL_API_KEY)",
        "Stripe ($STRIPE_KEY)"
      ]
    }
  },
  {
    "input": {
      "connectors": [
        {
          "service": "Stripe",
          "envVar": "STRIPE_KEY"
        }
      ],
      "command": "ls -la",
      "summary": "exit 0, 4 bytes out"
    },
    "expected": {
      "written": "exit 0, 4 bytes out",
      "spent": []
    }
  },
  {
    "input": {
      "connectors": [
        {
          "service": "Acme, Inc",
          "envVar": "ACME_KEY"
        }
      ],
      "command": "echo $ACME_KEY",
      "summary": "exit 0"
    },
    "expected": {
      "written": "used \"Acme, Inc\" ($ACME_KEY) · exit 0",
      "spent": [
        "Acme, Inc ($ACME_KEY)"
      ]
    }
  },
  {
    "input": {
      "connectors": [
        {
          "service": "Mistral",
          "envVar": "MISTRAL_API_KEY"
        },
        {
          "service": "Acme, Inc",
          "envVar": "ACME_KEY"
        }
      ],
      "command": "run $MISTRAL_API_KEY $ACME_KEY",
      "summary": "exit 0, 12 bytes out"
    },
    "expected": {
      "written": "used \"Acme, Inc\" ($ACME_KEY), Mistral ($MISTRAL_API_KEY) · exit 0, 12 bytes out",
      "spent": [
        "Acme, Inc ($ACME_KEY)",
        "Mistral ($MISTRAL_API_KEY)"
      ]
    }
  },
  {
    "input": {
      "connectors": [
        {
          "service": "The \"Prod\" Key",
          "envVar": "PROD_KEY"
        }
      ],
      "command": "echo $PROD_KEY",
      "summary": "exit 0"
    },
    "expected": {
      "written": "used \"The \"\"Prod\"\" Key\" ($PROD_KEY) · exit 0",
      "spent": [
        "The \"Prod\" Key ($PROD_KEY)"
      ]
    }
  },
  {
    "input": {
      "connectors": [
        {
          "service": "Acme · EU",
          "envVar": "ACME_EU_KEY"
        }
      ],
      "command": "echo $ACME_EU_KEY",
      "summary": "exit 0"
    },
    "expected": {
      "written": "used \"Acme · EU\" ($ACME_EU_KEY) · exit 0",
      "spent": [
        "Acme · EU ($ACME_EU_KEY)"
      ]
    }
  }
]
