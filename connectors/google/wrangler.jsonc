{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guaca-bot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",

  // Better Auth uses AsyncLocalStorage. `nodejs_als` would be enough today;
  // `nodejs_compat` is what its own Cloudflare guidance asks for and costs
  // nothing here, so an upgrade that reaches for another Node builtin is not
  // a production-only failure.
  "compatibility_flags": ["nodejs_compat"],

  // The apex, as a custom domain. Wrangler creates the record and the
  // certificate on deploy, and this is what `BETTER_AUTH_URL` below has to
  // agree with exactly: it is the origin every OAuth callback is registered
  // against.
  "routes": [{ "pattern": "guaca.bot", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The prerendered pages: the marketing one at the root, the install hub
    // and its five pages, and the two policies, each written as
    // `<name>/index.html` by the prerender. This is the setting that serves
    // `/install/box` and `/privacy` at the path itself, and redirects the
    // trailing-slash and `/index.html` forms to them, so every page has one
    // URL rather than three.
    "html_handling": "drop-trailing-slash",

    // Assets are matched before the Worker by default, which is what keeps the
    // prerendered page free of any of this. These paths are the exception, and
    // naming them means a file that lands in `dist/` can never shadow a
    // callback or a token endpoint.
    "run_worker_first": [
      "/api/*",
      "/app",
      "/app/*",
      "/signin",
      "/signin/*",
      "/signout",
      "/consent",
      "/mcp",
      "/mcp/*",
      // RFC 8414 puts this at the root of the origin, not under the Worker's
      // base path, and a client that follows the specification looks there
      // first. Named here so an asset can never answer it.
      "/.well-known/oauth-authorization-server",
      // The issuer is `/api/auth`, so RFC 8414's derivation inserts the
      // well-known segment in the middle and asks for
      // `/.well-known/oauth-authorization-server/api/auth`. The line above is
      // an exact match and does not cover it.
      "/.well-known/oauth-authorization-server/*",
      // RFC 9728, which the MCP specification requires: where a client learns
      // which authorization server guards `/mcp`. Both the bare path and the
      // path-inserted form, for the same reason as the pair above.
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*",
      // OpenID Connect Discovery, which a client reaches for because this
      // origin issues ID tokens. Same two forms as the pair above: the root
      // and RFC 8414's path-inserted derivation.
      "/.well-known/openid-configuration",
      "/.well-known/openid-configuration/*"
    ]
  },

  // The sign-in code, and nothing else. The sending domain is onboarded once,
  // and it is a subdomain rather than the apex so that apex mail, whenever
  // there is any, keeps its own SPF and DMARC and its own reputation:
  // `pnpm exec wrangler email sending enable email.guaca.bot`.
  // Local development never reaches this; see `worker/email.ts`.
  "send_email": [{ "name": "EMAIL" }],

  // Neither of these is a secret, and both are things a deploy must not be
  // able to forget, so they live in the file rather than in `wrangler secret`.
  // `.dev.vars` overrides them key by key for `wrangler dev`.
  "vars": {
    "EMAIL_FROM": "sign-in@email.guaca.bot",
    "BETTER_AUTH_URL": "https://guaca.bot"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guaca-bot",
      "database_id": "1538858c-514c-4eb5-876d-b18ff46b7048",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
