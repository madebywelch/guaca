# Verification environment.
#
# Guac ships as a native desktop binary, so there is no container in the
# product. This image exists to prove the code builds and its tests pass in a
# clean environment with nothing borrowed from a developer's machine.
#
#   docker build -f Dockerfile.ci -t guac-ci .
#   docker run --rm guac-ci
#
# GUI bundling is not attempted here: `cargo test` and `cargo clippy` need the
# webkit headers, not a display.

FROM rust:1.95-bookworm

# Tauri's Linux backend needs these to compile even when no window is opened.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev \
      libgtk-3-dev \
      libayatana-appindicator3-dev \
      librsvg2-dev \
      libssl-dev \
      pkg-config \
      curl \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Node from nodesource; the distro package lags too far behind.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable

RUN rustup component add clippy rustfmt

WORKDIR /app

# Dependency manifests first, so a source-only change reuses both caches.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY src-tauri/Cargo.toml src-tauri/Cargo.lock* ./src-tauri/
RUN mkdir -p src-tauri/src \
 && echo 'fn main() {}' > src-tauri/src/main.rs \
 && echo '' > src-tauri/src/lib.rs \
 && echo 'fn main() {}' > src-tauri/build.rs \
 && cargo fetch --manifest-path src-tauri/Cargo.toml \
 && rm -rf src-tauri/src src-tauri/build.rs

COPY . .

CMD ["./scripts/ci.sh"]
